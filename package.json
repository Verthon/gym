{
  "name": "gym",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.11.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.0.0 <13.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node src/index.ts",
    "check:no-js": "node scripts/check-no-js.mts",
    "type-check": "tsc",
    "test:unit": "vitest run",
    "scan:deadcode": "knip",
    "mutation": "stryker run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "pnpm check:no-js && pnpm lint && pnpm type-check && pnpm run test:unit",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@hono/node-server": "1.19.3",
    "hono": "4.9.8"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.6.4",
    "knip": "6.38.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "3.2.4"
  }
}
