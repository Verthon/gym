{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "outDir": "./dist",

    /* If your code doesn't run in the DOM: */
		"lib": ["es2022"],
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"]
		},

		/* Vitest Options */
		"types": ["node", "vitest/globals"]
  },
  "exclude": ["node_modules", "vitest.config.mts", "oxlint.config.mts"]
}
